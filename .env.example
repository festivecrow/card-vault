# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never put real keys in GitHub.

# --- Used by the website (safe to be public) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Server only (keep secret) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
TCGAPI_KEY=your-tcg-api-key
EBAY_CLIENT_ID=your-ebay-production-app-id
EBAY_CLIENT_SECRET=your-ebay-production-cert-id
CRON_SECRET=any-long-random-string

# --- Optional paid add-ons (leave out if you don't use them) ---
# SPORTSCARDSPRO_TOKEN=   sports singles and slabs
# PRICECHARTING_TOKEN=    graded Pokemon/TCG slabs
