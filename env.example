# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never put real keys in GitHub.

# --- Used by the website (safe to be public) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Server only (keep secret) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
TCGAPI_KEY=your-tcg-api-key
SPORTSCARDSPRO_TOKEN=your-40-character-sportscardspro-token
# Optional: only if you also subscribe to PriceCharting (graded Pokemon/TCG values)
PRICECHARTING_TOKEN=
CRON_SECRET=any-long-random-string
